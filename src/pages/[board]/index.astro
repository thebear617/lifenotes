---
import Layout from '../../layouts/Layout.astro';
import NoteWall from '../../components/NoteWall.astro';
import boards from '../../data/boards.js';
import { getCollection } from 'astro:content';
import { categoryForEntry } from '../../data/content.js';

type BoardId = 'life' | 'service' | 'humanities' | 'industry' | 'notes';

export async function getStaticPaths() {
  return Promise.all(boards.map(async (board) => {
    const entries = await getCollection(board.id as BoardId);
    return { params: { board: board.id }, props: { board, entries } };
  }));
}

const { board, entries } = Astro.props;
const base = import.meta.env.BASE_URL;
const items = entries.map((entry) => ({
  slug: entry.data.slug || entry.id,
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date,
  updated: entry.data.updated,
  category: categoryForEntry(entry),
  subcategory: entry.data.subcategory,
  href: `${base}${board.id}/${entry.data.slug || entry.id}/`,
}));
---

<Layout title={board.name} currentBoard={board.id} immersive wide>
  <NoteWall entries={items} board={board} boards={boards} base={base} />
</Layout>
