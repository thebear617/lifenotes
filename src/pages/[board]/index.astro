---
import Layout from '../../layouts/Layout.astro';
import boards from '../../data/boards.js';
import { getCollection } from 'astro:content';
import ListExplorer from '../../components/ListExplorer.astro';
import { categoryForEntry } from '../../data/content.js';

export async function getStaticPaths() {
  const getFormalEntries = (id: string) => {
    switch (id) {
      case 'industry': return getCollection('industry');
      case 'humanities': return getCollection('humanities');
      case 'notes': return getCollection('notes');
      default: return [];
    }
  };
  return Promise.all(boards
    .filter((board) => !['life', 'service'].includes(board.id))
    .map(async (board) => ({
      params: { board: board.id },
      props: { board, entries: await getFormalEntries(board.id) },
    })));
}

const { board, entries } = Astro.props;
const base = import.meta.env.BASE_URL;
const items = entries.map((entry) => ({
  slug: entry.data.slug || entry.id,
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date,
  updated: entry.data.updated,
  category: categoryForEntry(entry),
  subcategory: entry.data.subcategory,
  href: `${base}${board.id}/${entry.data.slug || entry.id}/`,
}));
---

<Layout title={board.name} currentBoard={board.id}>
  <h2 class="view-title">{board.name}</h2>
  <p class="view-sub">{board.subtitle}</p>
  <ListExplorer entries={items} />
</Layout>
