---
import Layout from '../../layouts/Layout.astro';
import boards from '../../data/boards.js';
import { getCollection } from 'astro:content';
import ListExplorer from '../../components/ListExplorer.astro';
import { categoryForEntry } from '../../data/content.js';

export async function getStaticPaths() {
  const getFormalEntries = (id) => {
    switch (id) {
      case 'ai': return getCollection('ai');
      case 'auto': return getCollection('auto');
      case 'biology': return getCollection('biology');
      case 'finance': return getCollection('finance');
      case 'food': return getCollection('food');
      case 'pet': return getCollection('pet');
      default: return [];
    }
  };
  return Promise.all(boards
    .filter((board) => !['life', 'hotel', 'phone'].includes(board.id))
    .map(async (board) => ({
      params: { board: board.id },
      props: { board, entries: await getFormalEntries(board.id) },
    })));
}

const { board, entries } = Astro.props;
const base = import.meta.env.BASE_URL;
const items = entries
  .filter((entry) => entry.data.visible)
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    description: entry.data.description,
    date: entry.data.date,
    category: categoryForEntry(entry),
    tags: entry.data.tags || [],
    href: `${base}${board.id}/${entry.slug}/`,
  }));
---

<Layout title={board.name} currentBoard={board.id}>
  <ListExplorer entries={items} />
</Layout>