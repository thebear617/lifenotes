---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import boards from '../../data/boards.js';
import ArticleToc from '../../components/ArticleToc.astro';
import ArticlePopover from '../../components/ArticlePopover.astro';
import PrintButton from '../../components/PrintButton.astro';
import { categoryForEntry, formatDate } from '../../data/content.js';

export async function getStaticPaths() {
  const formalBoardIds = ['industry', 'humanities', 'notes'];
  const getFormalEntries = (id) => {
    switch (id) {
      case 'industry': return getCollection('industry');
      case 'humanities': return getCollection('humanities');
      case 'notes': return getCollection('notes');
      default: return [];
    }
  };
  const formalPaths = (await Promise.all(formalBoardIds.map(async (id) => {
    const board = boards.find((item) => item.id === id);
    const entries = await getFormalEntries(id);
    return entries.map((entry) => ({ params: { board: id, slug: entry.data.slug || entry.id }, props: { board, entry } }));
  }))).flat();
  return formalPaths;
}

const { board, entry } = Astro.props;
const { Content, headings } = await render(entry);
const category = categoryForEntry(entry);
const base = import.meta.env.BASE_URL;
---

<Layout title={board.name} currentBoard={board.id}>
  <section class:list={['article-page-shell', { 'has-toc': headings.length > 0 }]}>
    <a class="back-link" href={`${base}${board.id}/`}>← 返回{board.name}领域</a>
    <div class="article-detail-layout">
      <ArticleToc headings={headings} />
      <article class="article-detail">
        <header class="article-header">
          <span class="article-category">{category}</span>
           <h1>{entry.data.title}</h1>
           <p class="article-meta">
              发布于 {formatDate(entry.data.date)}{entry.data.updated !== entry.data.date && ` · 更新于 ${formatDate(entry.data.updated)}`}
           </p>
          <PrintButton />
        </header>
        <div class="article-body"><Content /></div>
      </article>
      <ArticlePopover />
    </div>
  </section>
</Layout>
