---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ListExplorer from '../../components/ListExplorer.astro';
import { categoryForEntry } from '../../data/content.js';

const base = import.meta.env.BASE_URL;
const entries = (await getCollection('hotel')).filter((entry) => entry.data.visible);
const items = entries.map((entry) => ({
  slug: entry.slug,
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date,
  category: categoryForEntry(entry),
  subcategory: entry.data.subcategory,
  href: `${base}hotel/${entry.slug}/`,
}));
---

<Layout title="服务业" currentBoard="hotel">
  <h2 class="view-title">服务业</h2>
  <p class="view-sub">酒店 · 餐饮连锁 · 物流 · 零售</p>
  <ListExplorer entries={items} />
</Layout>