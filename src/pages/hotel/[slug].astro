---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import ArticlePopover from '../../components/ArticlePopover.astro';
import { categoryForEntry } from '../../data/content.js';

export async function getStaticPaths() {
  const entries = await getCollection('hotel');
  return entries.map((entry) => ({ params: { slug: entry.data.slug || entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const category = categoryForEntry(entry);
const base = import.meta.env.BASE_URL;
---

<Layout title="服务业" currentBoard="hotel">
  <section class:list={['article-page-shell', { 'has-toc': headings.length > 0 }]}>
    <a class="back-link" href={`${base}hotel/`}>← 返回服务业</a>
    <div class="article-detail-layout">
      <ArticleToc headings={headings} />
      <article class="article-detail">
        <header class="article-header">
          <span class="article-category">{category}</span>
          <h1>{entry.data.title}</h1>
          <p class="article-meta">
            发布于 {entry.data.date ? entry.data.date.toLocaleDateString('zh-CN') : '未标注日期'}{entry.data.updated && entry.data.updated !== entry.data.date && ` · 更新于 ${entry.data.updated.toLocaleDateString('zh-CN')}`}
          </p>
        </header>
        <div class="article-body"><Content /></div>
      </article>
      <ArticlePopover />
    </div>
  </section>
</Layout>
