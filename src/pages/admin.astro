---
// The local CMS is intentionally available only from Astro's dev server.
const isDev = import.meta.env.DEV;
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

{isDev ? <>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/png" href={`${base}favicon.png`} />
  <title>常识笔记后台</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html { min-width: 320px; background: #f7f3ee; }
    body {
      min-width: 320px;
      min-height: 100vh;
      margin: 0;
      background: #f7f3ee;
      color: #172033;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
    }
    button, input, select, textarea { font: inherit; }

    .admin {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr);
      gap: 6px;
      max-width: 1600px;
      height: 100vh;
      min-height: 720px;
      margin: auto;
      padding: 9px 16px 16px;
    }
    .topbar,
    .panel {
      border: 1px solid #e7ded5;
      background: rgba(255, 255, 255, .94);
      box-shadow: 0 3px 12px rgba(82, 54, 31, .055);
    }
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      min-height: 58px;
      padding: 9px 16px;
      border-radius: 9px;
    }
    .brand-group,
    .brand-lockup,
    .topbar-actions,
    .editor-actions,
    .status-group,
    .toolbar,
    .actions,
    .search-wrap,
    .editor-label,
    .panel-heading,
    .article-meta,
    .field-label {
      display: flex;
      align-items: center;
    }
    .brand-group { gap: 16px; min-width: 0; }
    .brand-lockup { gap: 13px; min-width: 0; }
    .brand-mark {
      display: grid;
      width: 34px;
      height: 34px;
      flex: 0 0 auto;
      place-items: center;
      color: #c2410c;
    }
    .brand-mark svg { width: 34px; height: 34px; }
    .brand-title {
      margin: 0;
      overflow: hidden;
      color: #c2410c;
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -.035em;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .environment {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 10px;
      border: 1px solid #e8d5c7;
      border-radius: 7px;
      color: #b45322;
      background: #fffaf6;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }
    .environment::before {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #f97316;
      content: "";
    }
    .topbar-actions { gap: 10px; }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 12px;
      border: 1px solid #e4dcd4;
      border-radius: 8px;
      color: #334155;
      background: #fff;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }
    .back-link:hover { border-color: #c2410c; color: #9a3412; background: #fffaf6; }

    .workspace {
      display: grid;
      grid-template-columns: minmax(300px, 356px) minmax(0, 1fr);
      gap: 6px;
      min-height: 0;
    }
    .panel { min-width: 0; border-radius: 9px; }
    .sidebar-panel {
      display: grid;
      grid-template-rows: auto auto auto minmax(0, 1fr);
      min-height: 0;
      padding: 20px 14px 11px;
    }
    .panel-heading {
      justify-content: space-between;
      margin: 0 0 15px;
      padding: 0;
    }
    .panel-heading h2,
    .editor-heading h2 {
      margin: 0;
      color: #172033;
      font-weight: 800;
      letter-spacing: -.025em;
    }
    .panel-heading h2 { font-size: 19px; }
    .count {
      color: #9aa0aa;
      font-size: 11px;
      font-weight: 600;
    }
    .search-wrap { position: relative; margin-bottom: 10px; }
    .search-wrap svg { position: absolute; left: 11px; width: 16px; height: 16px; color: #6b7280; pointer-events: none; }
    .search-wrap .search-icon-right { right: 10px; left: auto; }
    .search-wrap input { padding-right: 34px; padding-left: 34px; }
    .library-controls { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 6px; margin-bottom: 10px; }
    .library-controls .search-wrap { min-width: 0; margin-bottom: 0; }
    .library-actions { display: flex; gap: 6px; }
    .library-action-wrap { position: relative; }
    .library-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      min-height: 36px;
      padding: 0 8px;
      color: #5b6676;
      font-size: 11px;
      white-space: nowrap;
    }
    .library-action svg { width: 14px; height: 14px; flex: 0 0 auto; }
    .library-action.active { border-color: #e9a27c; color: #9a3412; background: #fff4eb; }
    .library-action[aria-expanded="true"] { border-color: #e9a27c; color: #9a3412; background: #fff4eb; }
    .control-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 16px;
      height: 16px;
      padding: 0 4px;
      border-radius: 999px;
      color: #fff;
      background: #c2410c;
      font-size: 10px;
      line-height: 1;
    }
    .library-popover {
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      z-index: 8;
      width: 190px;
      padding: 10px;
      border: 1px solid #e7ded5;
      border-radius: 9px;
      background: #fff;
      box-shadow: 0 8px 22px rgba(82, 54, 31, .14);
    }
    .library-popover[hidden] { display: none; }
    .library-popover-heading { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; color: #172033; font-size: 12px; }
    .library-popover-heading button { padding: 0; border: 0; color: #9a3412; background: transparent; font-size: 11px; font-weight: 600; }
    .library-popover-heading button:hover { border: 0; background: transparent; text-decoration: underline; }
    .sort-options { display: grid; gap: 4px; }
    .sort-option { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 32px; padding: 0 8px; border: 1px solid transparent; border-radius: 6px; color: #334155; background: transparent; font-size: 11px; text-align: left; }
    .sort-option small { color: #9aa0aa; font-size: 10px; font-weight: 600; }
    .sort-option:hover { border-color: #edc5af; color: #9a3412; background: #fffaf6; }
    .sort-option.on { color: #9a3412; background: #fff4eb; }
    .filter-fields { display: grid; gap: 8px; }
    .filter-field { display: grid; gap: 4px; color: #687285; font-size: 10px; font-weight: 700; }
    .filter-field select { min-height: 32px; padding: 5px 8px; font-size: 11px; }
    .filter-backdrop {
      position: fixed;
      inset: 0;
      z-index: 20;
      background: rgba(23, 32, 51, .2);
      backdrop-filter: blur(2px);
    }
    .filter-modal {
      position: fixed;
      top: 50%;
      left: 50%;
      z-index: 21;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      width: min(92vw, 440px);
      max-height: min(92vh, 640px);
      overflow: visible;
      transform: translate(-50%, -50%);
      border: 1px solid #e7ded5;
      border-radius: 14px;
      background: #fff;
      box-shadow: 0 18px 50px rgba(43, 31, 21, .2);
    }
    .filter-modal[hidden], .filter-backdrop[hidden] { display: none; }
    .filter-modal-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding: 20px 22px 16px; border-bottom: 1px solid #eee7e0; }
    .filter-modal-header h3 { margin: 0; color: #172033; font-size: 17px; letter-spacing: -.02em; }
    .filter-modal-header p { margin: 5px 0 0; color: #8992a1; font-size: 11px; line-height: 1.5; }
    .filter-modal-close { display: grid; width: 28px; height: 28px; place-items: center; padding: 0; border: 0; border-radius: 50%; color: #7b8491; background: transparent; font-size: 20px; line-height: 1; }
    .filter-modal-close:hover { border: 0; color: #9a3412; background: #fff4eb; }
    .filter-modal-body { overflow: visible; padding: 18px 22px 20px; }
    .filter-modal-body .filter-fields { gap: 14px; }
    .filter-modal-body .filter-field { gap: 6px; color: #334155; font-size: 11px; }
    .custom-select { position: relative; min-width: 0; }
    .custom-select-native { position: absolute; width: 1px; height: 1px; min-height: 0; padding: 0; border: 0; opacity: 0; pointer-events: none; }
    .custom-select-trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      min-height: 40px;
      padding: 8px 10px;
      border: 1px solid #e1d9d1;
      border-radius: 8px;
      color: #172033;
      background: #fff;
      font-size: 13px;
      font-weight: 600;
      text-align: left;
    }
    .custom-select-trigger:hover { border-color: #d97745; color: #172033; background: #fffaf6; }
    .custom-select-trigger:disabled { border-color: #e8e2dc; color: #a7adb6; background: #f7f5f2; cursor: not-allowed; }
    .custom-select-trigger svg { width: 16px; height: 16px; flex: 0 0 auto; color: #a0a7b1; transition: transform .15s ease, color .15s ease; }
    .custom-select.open .custom-select-trigger { border-color: #d97745; box-shadow: inset 0 0 0 1px #d97745; }
    .custom-select.open .custom-select-trigger svg { color: #c2410c; transform: rotate(180deg); }
    .custom-select-menu {
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      left: 0;
      z-index: 30;
      max-height: 300px;
      overflow-y: auto;
      padding: 5px;
      border: 1px solid #e7ded5;
      border-radius: 9px;
      background: #fff;
      box-shadow: 0 10px 24px rgba(82, 54, 31, .16);
    }
    .custom-select-menu[hidden] { display: none; }
    .custom-select-option {
      display: flex;
      align-items: center;
      width: 100%;
      min-height: 34px;
      padding: 0 9px;
      border: 0;
      border-radius: 6px;
      color: #334155;
      background: transparent;
      font-size: 12px;
      font-weight: 600;
      text-align: left;
    }
    .custom-select-option::before { width: 16px; flex: 0 0 16px; color: #c2410c; content: ""; font-size: 14px; font-weight: 800; }
    .custom-select-option:hover { border: 0; color: #9a3412; background: #fff4eb; }
    .custom-select-option.is-selected { color: #9a3412; background: #fff4eb; }
    .custom-select-option.is-selected::before { content: "✓"; }
    .filter-modal-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 22px; border-top: 1px solid #eee7e0; background: #fffdfb; }
    .filter-modal-footer .filter-clear-button { padding: 0; border: 0; color: #687285; background: transparent; font-size: 12px; font-weight: 600; }
    .filter-modal-footer .filter-clear-button:hover { border: 0; color: #9a3412; background: transparent; text-decoration: underline; }
    .filter-modal-footer .filter-done-button { min-height: 36px; padding: 0 16px; border-color: #c2410c; color: #fff; background: #c2410c; }
    .filter-modal-footer .filter-done-button:hover { border-color: #9a3412; color: #fff; background: #9a3412; }
    .toolbar { gap: 8px; margin-bottom: 16px; }
    .toolbar button:first-child { flex: 1 1 auto; }

    button {
      cursor: pointer;
      border: 1px solid #e1d9d1;
      border-radius: 8px;
      color: #334155;
      background: #fff;
      font-size: 13px;
      font-weight: 700;
      transition: border-color .15s, background .15s, color .15s, box-shadow .15s, opacity .15s;
    }
    button:hover { border-color: #c2410c; color: #9a3412; background: #fffaf6; }
    button:focus-visible { outline: 3px solid rgba(194, 65, 12, .16); outline-offset: 1px; }
    input:focus-visible, select:focus-visible, textarea:focus-visible { outline: none; }
    button:disabled { cursor: wait; opacity: .65; }
    button.primary {
      min-height: 40px;
      padding: 0 16px;
      border-color: #c2410c;
      color: #fff;
      background: #c2410c;
      box-shadow: 0 5px 12px rgba(194, 65, 12, .16);
    }
    button.primary:hover { border-color: #9a3412; color: #fff; background: #9a3412; }
    .toolbar button { min-height: 38px; padding: 0 12px; }
    .toolbar button:first-child { color: #fff; border-color: #c2410c; background: #c2410c; }
    .toolbar button:first-child:hover { border-color: #9a3412; background: #9a3412; }
    .toolbar svg { vertical-align: -3px; margin-right: 5px; }
    input:not([type="checkbox"]), select, textarea {
      width: 100%;
      border: 1px solid #e1d9d1;
      border-radius: 8px;
      color: #172033;
      background: #fff;
    }
    input, select { min-height: 36px; padding: 7px 10px; }
    textarea { resize: vertical; padding: 9px 10px; line-height: 1.55; }
    input:not([type="checkbox"]):focus, select:focus, textarea:focus { border-color: #d97745; box-shadow: inset 0 0 0 1px #d97745; outline: none; }
    .article-list {
      min-height: 0;
      overflow: auto;
      margin: 0 -5px;
      padding: 0 5px 4px;
      scrollbar-color: #c9c1b8 transparent;
      scrollbar-width: thin;
    }
    .article-list::-webkit-scrollbar { width: 8px; }
    .article-list::-webkit-scrollbar-thumb { border: 2px solid transparent; border-radius: 999px; background: #c9c1b8; background-clip: padding-box; }
    .article {
      display: block;
      width: 100%;
      margin: 0 0 6px;
      padding: 12px 12px 11px;
      text-align: left;
      border-color: #eee7e0;
      border-radius: 7px;
    }
    .article:hover { border-color: #edc5af; background: #fffaf6; }
    .article.active {
      position: relative;
      border-color: #f3b48f;
      background: #fff4eb;
      box-shadow: inset 3px 0 #df4b0b;
    }
    .article strong,
    .article small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .article strong { color: #172033; font-size: 13px; }
    .article small { margin-top: 5px; color: #687285; font-size: 11px; font-weight: 500; }
    .article-meta { gap: 7px; margin-top: 7px; overflow: hidden; color: #8992a1; font-size: 11px; white-space: nowrap; }
    .article-meta span { overflow: hidden; text-overflow: ellipsis; }
    .article-meta span + span::before { margin-right: 7px; color: #c1b8ae; content: "·"; }

    .main-panel {
      display: grid;
      grid-template-rows: auto auto minmax(0, 1fr);
      min-height: 0;
      padding: 20px 14px 12px;
    }
    .editor-heading { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin: 0 0 17px; padding: 0 2px; }
    .editor-heading h2 { font-size: 20px; }
    .editor-heading p { margin: 5px 0 0; color: #8992a1; font-size: 12px; }
    .editor-actions { flex: 0 0 auto; gap: 14px; }
    .status-group { gap: 9px; color: #87909c; font-size: 12px; white-space: nowrap; }
    .save-state { display: inline-flex; align-items: center; gap: 6px; }
    .save-state::before { width: 10px; height: 10px; border: 1.5px solid currentColor; border-radius: 50%; content: ""; }
    .save-state.saved { color: #15803d; font-weight: 700; }
    .save-state.saved::before { border-width: 2px; }
    .save-state.saving { color: #b45309; }
    .save-state.error { color: #b42318; white-space: normal; }
    .save-state.neutral { color: #87909c; }

    .fields { min-height: 0; margin-bottom: 12px; }
    .field-grid { display: grid; gap: 10px; }
    .field-card-grid { grid-template-columns: minmax(0, .84fr) minmax(0, .95fr) minmax(0, 1fr); }
    .field-card {
      min-width: 0;
      padding: 14px;
      border: 1px solid #eee7e0;
      border-radius: 8px;
      background: #fffdfb;
    }
    .field-card-heading { margin-bottom: 13px; }
    .field-card-heading h3 { margin: 0; color: #172033; font-size: 14px; }
    .field-card-heading p { margin: 4px 0 0; color: #9aa0aa; font-size: 11px; line-height: 1.45; }
    .field-stack { display: grid; min-width: 0; gap: 10px; }
    .field-row { display: grid; min-width: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .field-row.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .field-label { align-items: flex-start; flex-direction: column; gap: 5px; width: 100%; min-width: 0; color: #334155; font-size: 11px; font-weight: 700; }
    .field-label-caption { display: inline-flex; align-items: center; gap: 3px; min-height: 14px; }
    .field-label > input,
    .field-label > select,
    .field-label > textarea { display: block; width: 100%; min-width: 0; max-width: 100%; box-sizing: border-box; }
    .required { color: #c2410c; }
    .metadata-description { min-height: 74px; }
    .editor-workspace { --editor-content-gap: 28px; --editor-caret-space: 10.5em; position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: 0; border: 1px solid #eee7e0; border-radius: 8px; overflow: hidden; }
    .editor-sync-controls { position: absolute; top: 50%; left: 50%; z-index: 3; display: grid; gap: 3px; transform: translate(-50%, -50%); padding: 4px; border: 1px solid #e7ded5; border-radius: 999px; background: #fff; box-shadow: 0 4px 12px rgba(82, 54, 31, .12); }
    .editor-sync-button { display: grid; width: 25px; height: 25px; min-width: 25px; place-items: center; padding: 0; border: 0; border-radius: 50%; color: #647084; background: transparent; font-size: 16px; line-height: 1; }
    .editor-sync-button:hover { border: 0; color: #c2410c; background: #fff0e6; }
    .editor-sync-button:focus-visible { outline: 2px solid rgba(194, 65, 12, .28); outline-offset: 1px; }
    .editor-column { display: grid; grid-template-rows: auto auto minmax(0, 1fr) auto; min-width: 0; min-height: 0; }
    .editor-column:last-child { grid-template-rows: auto minmax(0, 1fr); }
    .editor-column + .editor-column { border-left: 1px solid #eee7e0; }
    .editor-label { min-height: 42px; justify-content: space-between; padding: 0 13px; border-bottom: 1px solid #eee7e0; color: #172033; font-size: 13px; font-weight: 800; }
    .editor-label span { color: #8e98a5; font-size: 11px; font-weight: 600; }
    .editor-toolbar { display: flex; align-items: center; gap: 2px; min-height: 37px; padding: 4px 8px; overflow-x: auto; border-bottom: 1px solid #eee7e0; background: #fffdfb; }
    .editor-tool { display: inline-grid; min-width: 27px; height: 27px; flex: 0 0 auto; place-items: center; padding: 0 5px; border: 0; border-radius: 5px; color: #4b5563; background: transparent; font-size: 13px; font-weight: 700; }
    .editor-tool:hover { border: 0; color: #9a3412; background: #fff0e6; }
    .editor-tool-divider { width: 1px; height: 20px; flex: 0 0 auto; margin: 0 5px; background: #e8e0d8; }
    .editor-pane { display: block; min-width: 0; min-height: 0; overflow: hidden; background: #fff; }
    textarea#body { display: block; width: 100%; max-width: 100%; min-width: 0; min-height: 0; height: 100%; resize: none; border: 0; border-radius: 0; padding: 15px var(--editor-content-gap) calc(15px + var(--editor-caret-space)) 15px; overflow-x: hidden; overflow-y: auto; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; color: #283449; font: 13px/1.75 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
    .editor-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 32px; padding: 0 12px; border-top: 1px solid #eee7e0; color: #87909c; font-size: 11px; }
    .editor-footer-left, .editor-footer-right { display: flex; align-items: center; gap: 14px; min-width: 0; }
    .editor-footer-right { color: #75806f; white-space: nowrap; }
    .auto-save { display: inline-flex; align-items: center; gap: 5px; }
    .auto-save::before { width: 7px; height: 7px; border-radius: 50%; background: #2f8f3a; content: ""; }
    .preview { min-height: 0; overflow: auto; padding: 15px var(--editor-content-gap) 15px 15px; background: #fff; color: #171717; font-size: .94rem; line-height: 1.8; transition: opacity .15s; }
    .preview.is-loading { opacity: .62; }
    .preview-error { color: #b42318; }
    .preview:empty::before { color: #a3a9b2; content: 'Markdown 预览会显示在这里'; }
    .preview h1, .preview h2, .preview h3 { color: #0f172a; scroll-margin-top: 1rem; }
    .preview h1 { margin: 1.8rem 0 .7rem; font-size: 1.35rem; }
    .preview h2 { margin: 1.5rem 0 .6rem; font-size: 1.18rem; }
    .preview h3 { margin: 1.15rem 0 .45rem; font-size: 1rem; }
    .preview h1:first-child, .preview h2:first-child, .preview h3:first-child { margin-top: 0; }
    .preview p { margin: .65rem 0; }
    .preview ul, .preview ol { margin: .45rem 0; padding-left: 1.35rem; }
    .preview ol { list-style-type: decimal; }
    .preview ol ol { list-style-type: lower-alpha; }
    .preview ol ol ol { list-style-type: lower-roman; }
    .preview ol ol ol ol { list-style-type: decimal; }
    .preview ul.contains-task-list { padding-left: 0; list-style: none; }
    .preview li + li { margin-top: .35rem; }
    .preview .task-list-item > input[type="checkbox"] { display: inline-block; width: 1rem; min-width: 1rem; max-width: 1rem; height: 1rem; margin: 0 .45rem 0 0; padding: 0; border: 0; border-radius: 0; background: transparent; vertical-align: -.12em; accent-color: #c2410c; }
    .preview .is-sync-target { border-radius: 4px; background: #fff1e7; box-shadow: 0 0 0 2px rgba(194, 65, 12, .12); }
    .preview blockquote { margin: .8rem 0; padding: .6rem .9rem; border-left: 3px solid #f6b17a; background: #fff4e8; color: #5b5149; }
    .preview .table-scroll { max-width: 100%; margin: .9rem 0; overflow-x: auto; }
    .preview .table-scroll table { margin: 0; }
