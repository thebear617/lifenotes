---
// The local CMS is intentionally available only from Astro's dev server.
const isDev = import.meta.env.DEV;
---

{isDev ? <>
  <meta charset="UTF-8" />
  <style>
    :global(*) { box-sizing: border-box; }
    :global(body) { margin: 0; background: #f5f1eb; color: #172033; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif; }
    .admin { max-width: 1600px; margin: auto; padding: clamp(20px, 4vw, 48px); }
    header { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 30px; }
    .eyebrow { margin: 0 0 6px; color: #c2410c; font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    h1 { margin: 0; color: #0f172a; font-size: clamp(25px, 3vw, 34px); letter-spacing: -.02em; }
    .hint { color: #687285; font-size: 13px; }
    header .hint { margin: 8px 0 0; }
    header a { padding: 9px 14px; border: 1px solid #d9d3cb; border-radius: 999px; background: #fff; color: #9a3412; font-size: 13px; font-weight: 700; text-decoration: none; white-space: nowrap; }
    header a:hover { border-color: #c2410c; background: #fff7ed; }
    .workspace { display: grid; grid-template-columns: minmax(260px, 300px) minmax(0, 1fr); gap: 24px; align-items: start; }
    .panel { min-width: 0; padding: clamp(18px, 2.5vw, 30px); border: 1px solid #e2ddd6; border-radius: 16px; background: rgba(255, 255, 255, .92); box-shadow: 0 10px 30px rgba(30, 41, 59, .06); }
    .sidebar-panel { position: sticky; top: 24px; padding: 20px; }
    .panel-heading { margin-bottom: 18px; }
    .panel-heading h2 { margin: 0; color: #0f172a; font-size: 16px; }
    .panel-heading p { margin: 4px 0 0; color: #8992a1; font-size: 12px; }
    .toolbar, .actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .toolbar { margin-bottom: 14px; }
    button, select, input, textarea { font: inherit; }
    button { cursor: pointer; border: 1px solid #d5cec6; background: #fff; color: #334155; border-radius: 9px; padding: 9px 13px; font-size: 13px; font-weight: 700; transition: border-color .15s, background .15s, color .15s, box-shadow .15s; }
    button:hover { border-color: #c2410c; color: #9a3412; background: #fffaf5; }
    button.primary { color: white; background: #c2410c; border-color: #c2410c; box-shadow: 0 5px 12px rgba(194, 65, 12, .18); }
    button.primary:hover { color: white; background: #9a3412; border-color: #9a3412; }
    input, select, textarea { width: 100%; border: 1px solid #d8d2ca; border-radius: 9px; background: #fff; color: #172033; outline: none; }
    input, select { min-height: 40px; padding: 8px 11px; }
    input:focus, select:focus, textarea:focus { border-color: #c2410c; box-shadow: 0 0 0 3px rgba(194, 65, 12, .12); }
    .search { margin-bottom: 16px; }
    .article-list { max-height: min(65vh, 720px); overflow: auto; margin: 0 -8px; padding: 0 8px; }
    .article { display: block; width: 100%; margin: 2px 0; padding: 12px 11px; text-align: left; border: 1px solid transparent; border-radius: 9px; }
    .article:hover { border-color: #f2c9ae; background: #fff7ed; }
    .article strong, .article small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .article strong { color: #263247; }
    .article small { margin-top: 4px; color: #8992a1; font-size: 11px; font-weight: 500; }
    .editor-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 22px; }
    .editor-heading h2 { margin: 0; color: #0f172a; font-size: 20px; }
    .editor-heading p { margin: 5px 0 0; color: #7b8493; font-size: 12px; }
    .fields { margin-bottom: 22px; padding-bottom: 22px; border-bottom: 1px solid #eee9e3; }
    .field-group + .field-group { margin-top: 24px; padding-top: 22px; border-top: 1px solid #eee9e3; }
    .field-group-heading { margin-bottom: 14px; }
    .field-group-heading h3 { margin: 0; color: #263247; font-size: 14px; }
    .field-group-heading p { margin: 4px 0 0; color: #8992a1; font-size: 12px; font-weight: 500; }
    .field-grid { display: grid; gap: 16px; }
    .core-grid { grid-template-columns: 1fr; }
    .taxonomy-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .file-grid { grid-template-columns: minmax(0, 2fr) minmax(180px, 1fr); }
    .publish-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 16px; }
    .fields .metadata-description { min-height: 86px; padding: 10px 11px; resize: vertical; line-height: 1.5; }
    label { display: grid; gap: 7px; min-width: 0; color: #647084; font-size: 12px; font-weight: 700; }
    .actions { margin-bottom: 20px; }
    .status { min-height: 20px; color: #527d57; font-size: 12px; }
    .error { color: #b42318; }
    .edit-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; }
    .editor-column { min-width: 0; }
    .editor-label { display: flex; justify-content: space-between; align-items: baseline; margin: 0 0 8px; color: #445066; font-size: 12px; font-weight: 800; }
    .editor-label span { color: #9aa2af; font-size: 11px; font-weight: 500; }
    textarea, .preview { min-height: 560px; resize: vertical; padding: 16px; border: 1px solid #d8d2ca; border-radius: 10px; line-height: 1.75; }
    textarea { display: block; }
    .preview { overflow: auto; background: #fffdfa; color: #334155; }
    .preview:empty::before { content: 'Markdown 预览会显示在这里'; color: #a3a9b2; }
    .preview h1, .preview h2, .preview h3 { margin: .5em 0; color: #0f172a; }
    .preview pre { padding: 12px; overflow: auto; background: #f4f1ec; border-radius: 7px; }
    .preview blockquote { margin: 1em 0; padding: 8px 12px; border-left: 3px solid #f6b17a; background: #fff4e8; color: #6b625b; }
    @media (max-width: 1100px) { .taxonomy-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 800px) { header { align-items: flex-start; } .workspace, .edit-grid { grid-template-columns: 1fr; } .sidebar-panel { position: static; } .article-list { max-height: 300px; } textarea, .preview { min-height: 420px; } }
    @media (max-width: 640px) { .file-grid, .publish-grid, .taxonomy-grid { grid-template-columns: 1fr; } .publish-grid { margin-top: 13px; } }
    @media (max-width: 520px) { .admin { padding: 18px 12px 30px; } header { flex-direction: column; gap: 14px; margin-bottom: 20px; } header a { align-self: flex-start; } .panel { padding: 17px 14px; border-radius: 12px; } .field-grid { gap: 13px; } .field-group + .field-group { margin-top: 20px; padding-top: 18px; } .editor-heading { margin-bottom: 18px; } }
  </style>
  <div class="admin">
    <header><div><p class="eyebrow">Local workspace</p><h1>LifeNotes 本地 CMS</h1><p class="hint">仅用于 npm run dev · 保存会直接写入 src/content/</p></div><a href="/">返回站点</a></header>
    <div class="workspace">
      <aside class="panel sidebar-panel"><div class="panel-heading"><h2>文章库</h2><p>选择文章继续编辑，或创建一篇新的记录。</p></div><div class="toolbar"><button id="new">新建文章</button><button id="refresh">刷新</button></div><input class="search" id="filter" placeholder="筛选标题…" /><div id="list" class="article-list"></div></aside>
      <main class="panel"><div class="editor-heading"><div><h2>编辑文章</h2><p>先填写文章信息，再在下方编辑 Markdown 内容。</p></div></div><div class="fields">
        <section class="field-group"><div class="field-group-heading"><h3>内容核心</h3><p>文章标题和摘要会优先展示在文章列表与详情页。</p></div><div class="field-grid core-grid">
          <label>标题<input id="title" /></label><label>描述<textarea class="metadata-description" id="description" rows="3"></textarea></label>
        </div></section>
        <section class="field-group"><div class="field-group-heading"><h3>内容归类</h3><p>用领域和主题信息帮助整理、筛选文章。</p></div><div class="field-grid taxonomy-grid">
          <label>领域 <select id="board"><option value="life">life · 生活美食</option><option value="hotel">hotel · 服务业</option><option value="ai">ai · AI产业</option><option value="auto">auto · 数码出行</option><option value="biology">biology · 动植物</option><option value="finance">finance · 金融经济</option><option value="history">history · 社会人文</option></select></label>
          <label>分类<input id="category" /></label><label>子分类<input id="subcategory" /></label><label>topic<input id="topic" /></label>
        </div></section>
        <section class="field-group"><div class="field-group-heading"><h3>文件与发布</h3><p>文件名决定保存位置，slug 与发布日期用于发布信息。</p></div><div class="field-grid file-grid">
          <label>文件名（含 .md）<input id="file" /></label><label>slug<input id="slug" /></label>
        </div><div class="field-grid publish-grid">
          <label>发布日期<input id="date" type="date" /></label><label>更新日期<input id="updated" type="date" /></label><label>format<select id="format"><option>note</option><option>article</option></select></label><label>可见<select id="visible"><option value="true">是</option><option value="false">否</option></select></label>
        </div></section>
      </div><div class="actions"><button id="save" class="primary">保存文章</button><span id="status" class="status" aria-live="polite"></span></div>
        <div class="edit-grid"><div class="editor-column"><div class="editor-label">Markdown 内容<span>实时预览</span></div><textarea id="body" placeholder="在这里编辑 Markdown…"></textarea></div><div class="editor-column"><div class="editor-label">预览<span>基础 Markdown</span></div><article id="preview" class="preview"></article></div></div>
      </main>
    </div>
  </div>
  <script>
    const $ = (id) => document.getElementById(id);
    let articles = [];
    const fields = ['title','description','category','subcategory','topic','date','updated','slug','format','visible'];
    const escapeHtml = (text) => text.replace(/[&<>"']/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    function preview() { let html = escapeHtml($('body').value).replace(/^### (.*)$/gm, '<h3>$1</h3>').replace(/^## (.*)$/gm, '<h2>$1</h2>').replace(/^# (.*)$/gm, '<h1>$1</h1>').replace(/^> (.*)$/gm, '<blockquote>$1</blockquote>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/`([^`]+)`/g, '<code>$1</code>').replace(/^(\d+\. .*)$/gm, '<div>$1</div>').replace(/^- (.*)$/gm, '<div>• $1</div>').replace(/\n{2,}/g, '<br><br>').replace(/\n/g, '<br>'); $('preview').innerHTML = html; }
    function fill(item = {}) { $('board').value = (item.path || 'life/').split('/')[0]; $('file').value = item.path ? item.path.split('/').slice(1).join('/') : '新文章.md'; fields.forEach((field) => { if ($(field)) $(field).value = item[field] ?? (field === 'visible' ? 'true' : field === 'format' ? 'note' : ''); }); $('body').value = item.body || ''; preview(); }
    async function loadList() { const res = await fetch('/admin/api/articles'); const data = await res.json(); articles = data.articles || []; renderList(); }
    function renderList() { const query = $('filter').value.toLowerCase(); $('list').innerHTML = articles.filter((a) => a.title.toLowerCase().includes(query)).map((a) => `<button class="article" data-path="${encodeURIComponent(a.path)}"><strong>${escapeHtml(a.title)}</strong><small>${escapeHtml(a.path)}</small></button>`).join('') || '<p class="hint">暂无文章</p>'; document.querySelectorAll('.article').forEach((button) => button.onclick = () => loadArticle(decodeURIComponent(button.dataset.path))); }
    async function loadArticle(articlePath) { const res = await fetch('/admin/api/article?path=' + encodeURIComponent(articlePath)); const data = await res.json(); fill({ path: data.path, body: data.body, ...data.frontmatter }); $('status').textContent = '已读取'; }
    $('save').onclick = async () => { const board = $('board').value; const file = $('file').value.trim(); const frontmatter = Object.fromEntries(fields.map((field) => [field, $(field).value])); frontmatter.visible = frontmatter.visible === 'true'; const res = await fetch('/admin/api/article', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ path: board + '/' + file, frontmatter, body: $('body').value }) }); const data = await res.json(); $('status').textContent = res.ok ? `已保存：${data.path}` : (data.errors || [data.error]).join('；'); $('status').className = res.ok ? 'status' : 'status error'; if (res.ok) loadList(); };
    $('new').onclick = () => { fill(); $('status').textContent = '新建模式'; }; $('refresh').onclick = loadList; $('filter').oninput = renderList; $('body').oninput = preview; fill(); loadList();
  </script>
</> : <p>本地 CMS 仅在 Astro 开发服务器中可用。</p>}
