---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ListExplorer from '../../components/ListExplorer.astro';
import { categoryForEntry } from '../../data/content.js';

const base = import.meta.env.BASE_URL;
const entries = (await getCollection('life')).filter((entry) => entry.data.visible);
const items = entries.map((entry) => ({
  slug: entry.slug,
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date,
  category: categoryForEntry(entry),
  tags: entry.data.tags || [],
  href: `${base}life/${entry.slug}/`,
}));
---

<Layout title="生活" currentBoard="life">
  <ListExplorer entries={items} />
</Layout>