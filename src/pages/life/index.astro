---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ListExplorer from '../../components/ListExplorer.astro';
import { categoryForEntry } from '../../data/content.js';

const base = import.meta.env.BASE_URL;
const entries = (await getCollection('life')).filter((entry) => entry.data.visible);
const items = entries.map((entry) => ({
  slug: entry.data.slug || entry.id,
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date,
  category: categoryForEntry(entry),
  subcategory: entry.data.subcategory,
  href: `${base}life/${entry.data.slug || entry.id}/`,
}));
---

<Layout title="生活美食" currentBoard="life">
  <h2 class="view-title">生活美食</h2>
  <p class="view-sub">厨房常识 · 清洁 · 急救 · 菜谱 · 探店</p>
  <ListExplorer entries={items} />
</Layout>
