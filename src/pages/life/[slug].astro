---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import ArticlePopover from '../../components/ArticlePopover.astro';
import PrintButton from '../../components/PrintButton.astro';
import { categoryForEntry, formatDate } from '../../data/content.js';

export async function getStaticPaths() {
  const entries = await getCollection('life');
  return entries.map((entry) => ({ params: { slug: entry.data.slug || entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const category = categoryForEntry(entry);
const base = import.meta.env.BASE_URL;
---

<Layout title="生活美食" currentBoard="life">
  <section class:list={['article-page-shell', { 'has-toc': headings.length > 0 }]}>
    <a class="back-link" href={`${base}life/`}>← 返回生活美食</a>
    <div class="article-detail-layout">
      <ArticleToc headings={headings} />
      <article class="article-detail">
        <header class="article-header">
          <span class="article-category">{category}</span>
           <h1>{entry.data.title}</h1>
           <p class="article-meta">
              发布于 {formatDate(entry.data.date)}{entry.data.updated !== entry.data.date && ` · 更新于 ${formatDate(entry.data.updated)}`}
           </p>
          <PrintButton />
        </header>
        <div class="article-body"><Content /></div>
      </article>
      <ArticlePopover />
    </div>
  </section>
</Layout>
