---
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  currentBoard?: string | null;
  wide?: boolean;
  /** 列表页使用：内容区走通栏瀑布流 */
  immersive?: boolean;
}

const { title = '常识笔记', wide = false, immersive = false } = Astro.props;
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = (path = '') => `${base}${path}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="LifeNotes · 个人常识笔记" />
    <link rel="icon" type="image/png" href={href('favicon.png')} />
    <title>{title} · lifenotes</title>
  </head>
  <body class:list={[immersive ? 'immersive' : 'detail-page']}>
    <div class="layout">
      <div class="main-area">
        <main class:list={['app-shell', { 'app-shell-wide': wide }]}>
          <slot />
        </main>
      </div>
    </div>

    <script>
      import '../scripts/layout';
    </script>
  </body>
</html>
