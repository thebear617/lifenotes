---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import boards from '../data/boards.js';

interface Props {
  title?: string;
  currentBoard?: string | null;
  wide?: boolean;
}

const { title = '常识笔记', currentBoard = null, wide = false } = Astro.props;
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = (path = '') => `${base}${path}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="LifeNotes · 个人常识笔记" />
    <link rel="icon" type="image/png" href={href('favicon.png')} />
    <title>{title} · lifenotes</title>
  </head>
  <body class="sidebar-collapsed">
    <div class="layout">
      <button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="展开侧边栏" aria-expanded="false">☰</button>
      <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

      <nav class="sidebar" id="sidebar" aria-label="主导航">
        <div class="sidebar-brand">
          <button class="sidebar-close" id="sidebarClose" type="button" aria-label="关闭侧边栏">✕</button>
          <button class="sidebar-collapse" id="sidebarCollapse" type="button" aria-label="收起侧边栏" title="收起侧边栏">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="4" width="17" height="16" rx="2"></rect><path d="M9 4v16"></path><path d="m15 9-3 3 3 3"></path></svg>
          </button>
          <svg class="sidebar-brand-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v16"></path><path d="M20.001 19A2 2 0 0 0 22 17V5a2 2 0 0 0-1.999-2L16 3.002A5 5 0 0 0 12 5a5 5 0 0 0-4-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 1.999 2H8a5 5 0 0 1 4 2 5 5 0 0 1 4-2z"></path></svg>
          <p class="sidebar-eyebrow">LIFE NOTES</p>
          <h1 class="sidebar-title">常识笔记</h1>
          <span class="sidebar-subtitle">个人常识资料库</span>
        </div>
        <div class="sidebar-nav">
          {boards.map((board) => (
            <a
              class:list={['sidebar-item', { active: currentBoard === board.id }]}
              href={href(`${board.id}/`)}
              aria-current={currentBoard === board.id ? 'page' : undefined}
            >
              <span class="sidebar-icon">{board.icon}</span>
              <span>{board.name}</span>
            </a>
          ))}
        </div>
      </nav>

      <div class="main-area">
        <main class:list={['app-shell', { 'app-shell-wide': wide }]}>
          <slot />
        </main>
      </div>
    </div>

    <script>
      import '../scripts/layout';
    </script>
  </body>
</html>
