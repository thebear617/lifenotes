---
const { headings = [] } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth >= 1 && heading.depth <= 3);
const tocSections = [];
let currentTocGroup;
for (const heading of tocHeadings) {
  if (heading.depth === 2) {
    currentTocGroup = { type: 'group', heading, children: [] };
    tocSections.push(currentTocGroup);
  } else if (heading.depth === 3 && currentTocGroup) {
    currentTocGroup.children.push(heading);
  } else {
    tocSections.push({ type: 'standalone', heading });
  }
}
---

{tocHeadings.length > 0 && (
  <aside class="article-toc-column" aria-label="文章目录">
    <details class="article-toc" open>
      <summary>本文目录</summary>
      <nav>
        {tocSections.map((section) => section.type === 'group' ? (
          <section class="article-toc-group" data-expanded="true">
            <div class="article-toc-group-header">
              <a href={`#${section.heading.slug}`} class="article-toc-link depth-2" data-heading-id={section.heading.slug}>
                {section.heading.text}
              </a>
            </div>
            <div class="article-toc-sublist">
              <div>
                {section.children.map((heading) => (
                  <a href={`#${heading.slug}`} class:list={[`article-toc-link depth-${heading.depth}`]} data-heading-id={heading.slug}>
                    {heading.text}
                  </a>
                ))}
              </div>
            </div>
          </section>
        ) : (
          <a href={`#${section.heading.slug}`} class:list={[`article-toc-link depth-${section.heading.depth}`]} data-heading-id={section.heading.slug}>
            {section.heading.text}
          </a>
        ))}
      </nav>
    </details>
  </aside>
)}

{tocHeadings.length > 0 && (
  <script>
    const tocLinks = Array.from(document.querySelectorAll('.article-toc-link'));
    const articleHeadings = Array.from(document.querySelectorAll('.article-body h1[id], .article-body h2[id], .article-body h3[id]'));
    const tocGroups = Array.from(document.querySelectorAll('.article-toc-group'));
    const headingGroups = new Map();
    tocGroups.forEach((group) => group.querySelectorAll('.article-toc-link').forEach((link) => headingGroups.set(link.dataset.headingId, group)));

    function syncExpandedGroups(activeId) {
      const activeGroup = headingGroups.get(activeId);
      tocGroups.forEach((group) => {
        group.dataset.expanded = String(group === activeGroup);
      });
    }

    function setActiveHeading(id) {
      tocLinks.forEach((link) => {
        const active = link.dataset.headingId === id;
        link.classList.toggle('active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      const activeGroup = headingGroups.get(id);
      activeGroup?.querySelector('.article-toc-link.depth-2')?.classList.add('active');
      syncExpandedGroups(id);
    }

    let ticking = false;
    function updateActiveHeading() {
      let activeId = articleHeadings[0]?.id;
      for (const heading of articleHeadings) {
        if (heading.getBoundingClientRect().top <= 120) activeId = heading.id;
        else break;
      }
      if (activeId) setActiveHeading(activeId);
      ticking = false;
    }

    function requestHeadingUpdate() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateActiveHeading);
    }

    updateActiveHeading();
    window.addEventListener('scroll', requestHeadingUpdate, { passive: true });
    window.addEventListener('hashchange', requestHeadingUpdate);
  </script>
)}
